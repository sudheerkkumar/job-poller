# Copy to .env and fill in. Never commit .env.

# Required for scoring: free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: Telegram alerts (docs/telegram.md). Leave empty to use the console only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: Postgres password used by docker-compose (default: jobpoller)
POSTGRES_PASSWORD=
